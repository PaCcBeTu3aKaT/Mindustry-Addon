// Селена — спутник земного типа планеты Серпуло

alwaysUnlocked: true
accessible: true
visible: true

// --- Орбита ---
parent: serpulo
solarSystem: sun
radius: 0.6
sectorSize: 2
orbitRadius: 3.2
orbitSpacing: 1
drawOrbit: true
tidalLock: true
startSector: 10
sectorSeed: 7
minZoom: 1

// --- Поверхность: океаны, суша, пустыни, снежные шапки ---
mesh: [
  {
    // океан
    type: NoiseMesh
    planet: selena
    divisions: 5
    seed: 12
    radius: 0.6055
    color1: 2f5f9e
    color2: 3f78bd
    octaves: 3.5
    persistence: 0.9
  }
  {
    // суша
    type: NoiseMesh
    planet: selena
    divisions: 5
    seed: 41
    radius: 0.6025
    color1: 5d8a4a
    color2: 7a9a55
    octaves: 4.2
    persistence: 0.8
  }
  {
    // пустыни
    type: NoiseMesh
    planet: selena
    divisions: 5
    seed: 77
    radius: 0.6040
    color1: c9b37a
    color2: b89f66
    octaves: 4.8
    persistence: 0.7
  }
  {
    // снег и лёд
    type: NoiseMesh
    planet: selena
    divisions: 5
    seed: 5
    radius: 0.6070
    color1: eef5f8
    color2: cfdfe6
    octaves: 4.5
    persistence: 1.0
  }
]

// --- Облака ---
cloudMesh: [
  {
    type: HexSkyMesh
    planet: selena
    speed: 1.1
    radius: 0.06
    divisions: 6
    color: ffffff6e
    octaves: 3
    persistence: 0.4
    scl: 1
    thresh: 0.6
  }
  {
    type: HexSkyMesh
    planet: selena
    speed: 0.9
    radius: 0.07
    divisions: 6
    color: ffffff55
    octaves: 3
    persistence: 0.5
    scl: 0.9
    thresh: 0.6
  }
]

// --- Атмосфера ---
hasAtmosphere: true
atmosphereColor: 5b9bd5
atmosphereRadIn: 0.02
atmosphereRadOut: 0.3
iconColor: 5b9bd5
landCloudColor: ffffff80
bloom: false
updateLighting: false

// --- Генерация секторов ---
// Серпуло-подобные карты: суша, руда, споры, вода.
generator: {
  type: SerpuloPlanetGenerator
}
// Запасной вариант, если игра не примет SerpuloPlanetGenerator
// (формат как у asthosus, генератор астероидных секторов):
// generator: {
//   octaves: 3
//   persistence: 0.52
//   scale: 22
//   mag: 0.721
//   thresh: 1.152
//   min: 100
//   max: 100
//   radMin: 220
//   radMax: 600
//   iceChance: 0.2
//   carbonChance: 0.3
//   berylChance: 0
//   ferricChance: 0.2
// }

// --- Правила кампании (по образцу Серпуло) ---
allowCampaignRules: true
allowWaves: true
allowSectorInvasion: true
allowLaunchSchematics: true
allowLaunchLoadout: true
allowLegacyLaunchPads: true
allowSelfSectorLaunch: true
allowLaunchToNumbered: true
enemyCoreSpawnReplace: true
showRtsAIRule: true
launchCapacityMultiplier: 0.5

rules: {
  placeRangeCheck: false
  hideSpawns: true
  derelictRepair: true
  coreDestroyClear: true
}

campaignRuleDefaults: {
  hideSpawns: true
}

defaultCore: core-shard
